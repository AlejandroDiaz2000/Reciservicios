# =============================================================================
# VARIABLES DE ENTORNO - Compliance Suite / Selección de Proveedores
# Copia este archivo como ".env" (local) y configura las mismas llaves como
# "Environment Variables" en Vercel (o el proveedor de hosting que uses).
# NUNCA subas el archivo ".env" real a GitHub.
# =============================================================================

# --- Base de datos PostgreSQL (Supabase, Neon, RDS, etc.) -------------------
# Cadena de conexión con pooling (para runtime de la app / serverless)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?pgbouncer=true"
# Cadena de conexión directa (para migraciones de Prisma)
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos"

# --- Autenticación (NextAuth.js) ---------------------------------------------
# Genera un valor aleatorio seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-por-un-valor-aleatorio-seguro"
# URL pública de la aplicación desplegada
NEXTAUTH_URL="http://localhost:3000"

# --- Almacenamiento de objetos compatible con S3 -----------------------------
# Funciona con AWS S3, Cloudflare R2, Supabase Storage (S3 compatible), etc.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="proveedores-app-documentos"
S3_ACCESS_KEY_ID="reemplaza-por-tu-access-key"
S3_SECRET_ACCESS_KEY="reemplaza-por-tu-secret-key"
# Forzar path-style (necesario para algunos proveedores S3-compatibles)
S3_FORCE_PATH_STYLE="true"

# --- Información de la empresa (usada en el informe/reportes) ---------------
EMPRESA_NOMBRE="Nombre de la Empresa de Transporte de Carga S.A.S."
EMPRESA_NIT="900.000.000-0"
